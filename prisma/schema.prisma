generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameZh      String   @default("") @map("name_zh")
  brand       String
  price       Int
  oldPrice    Int      @default(0) @map("old_price")
  accent      String   @default("from-slate-700 via-stone-700 to-neutral-900")
  accentColor String   @default("#facc15") @map("accent_color")
  image       String   @db.Text
  description String
  descriptionZh String @default("") @map("description_zh")
  highlights  String[]
  groupType   String   @map("group_type")
  type        String   @default("product")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([groupType])
  @@map("products")
}

model Order {
  id        String      @id @default(cuid())
  type      String      @default("product")
  channel   String      @default("whatsapp")
  status    String      @default("pending")
  total     Int         @default(0)
  customer  String      @default("")
  phone     String      @default("")
  metadata  String      @default("{}") @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  items     OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  name      String
  category  String   @default("")
  quantity  Int
  unitPrice Int      @map("unit_price")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  phone     String
  subject   String
  body      String
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([archived, createdAt])
  @@index([phone, createdAt])
  @@map("messages")
}
