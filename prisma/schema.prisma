generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String
  price       Int
  oldPrice    Int      @default(0)
  accent      String   @default("from-slate-700 via-stone-700 to-neutral-900")
  accentColor String   @default("#facc15")
  image       String   @db.Text
  description String
  highlights  String[]
  groupType   String
  type        String   @default("product")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupType])
}
